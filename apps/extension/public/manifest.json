{
  "manifest_version": 3,
  "name": "Company Vault",
  "version": "0.1.0",
  "description": "Company Vault browser extension for autofilling passwords and secrets.",
  "action": {
    "default_popup": "index.html",
    "default_title": "Company Vault"
  },
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://password-manager-beige-seven.vercel.app/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["assets/content.js"],
      "run_at": "document_idle"
    }
  ]
}
